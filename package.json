{
  "name": "dsh-ui-state",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Report the Web UI focus and sidebar layout to the agent as a read-only ui_state tool.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "docs", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true }
  }
}